PORT=4317
HOST=0.0.0.0
CODEXBRO_PUBLIC_SERVER_URL=http://localhost:4317
CODEXBRO_CORS_ORIGIN=http://localhost:5174
CODEXBRO_DATA_DIR=.codexbro
CODEXBRO_STORAGE=sqlite
CODEXBRO_STALE_WORKER_MS=45000
CODEXBRO_STALE_MAX_ATTEMPTS=3
CODEXBRO_STALE_RETRY_BACKOFF_MS=5000

# Used by packages/web at build time when the API is not same-origin.
VITE_CODEXBRO_API_URL=http://localhost:4317

# Used by packages/web during local development.
VITE_PORT=5173
VITE_PROXY_API_TARGET=http://localhost:4317

# Optional local worker native-control settings.
# CODEXBRO_NATIVE_TASK_BACKEND=desktop
# CODEXBRO_DESKTOP_ALLOW_FOREGROUND=true
# CODEXBRO_DESKTOP_BRIDGE_SMOKE_READINESS=true
# CODEXBRO_DESKTOP_BRIDGE_SMOKE_TIMEOUT_MS=180000
